# Fail `npm ci` / `npm install` immediately on an unsupported Node version.
#
# Without this, npm only prints an EBADENGINE *warning* and the install succeeds, so an
# unsupported Node does not surface until a later step fails for an unrelated-looking
# reason. That is exactly how the Node 18 matrix leg broke: the whole eslint 10 stack and
# vite 7 (via vitest) require ^20.19.0 || ^22.13.0 || >=24, but CI reported it as a Lint
# failure, three steps after the actual cause.
#
# This file is never published — npm excludes .npmrc from package tarballs — so it
# constrains this repo's contributors only, not consumers of the package.
engine-strict=true
