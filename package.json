{
  "name": "tokendamper",
  "version": "1.7.0",
  "private": false,
  "description": "Universal context optimization for AI coding assistants.",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Epichlo/TokenDamper.git"
  },
  "homepage": "https://github.com/Epichlo/TokenDamper",
  "keywords": [
    "llm",
    "context-optimization",
    "token-reduction",
    "mcp",
    "model-context-protocol",
    "prompt-engineering",
    "anthropic",
    "openai"
  ],
  "license": "MPL-2.0",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "tokendamper": "./dist/src/cli/main.js"
  },
  "files": [
    "dist",
    "test/fixtures/bench",
    "README.md",
    "ARCHITECTURE.md",
    "ROADMAP.md",
    "DECISIONS.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "node ./node_modules/eslint/bin/eslint.js src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/cli/main.js",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run lint && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^10.8.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
